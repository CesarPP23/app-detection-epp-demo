# Plantilla de /etc/epp-edge/edge.env  (root:epp, modo 0640). VALORES FICTICIOS.
# Copiar y completar en la Pi; este archivo real NUNCA se versiona.

# --- Identidad y servicio en la nube -------------------------------------------------------------
DEVICE_ID=raspberry-pi-01
GCP_PROJECT_ID=epp-detection-v1
CONTROL_DATABASE_ID=(default)
DETECTIONS_DATABASE_ID=dbraspberry
GOOGLE_APPLICATION_CREDENTIALS=/etc/epp-edge/gcp-key.json
LAKE_BUCKET=epp-detection-v1-lake

# Host de Cloud Run SIN esquema ni ruta (se arma wss://<host>/ws/video/<DEVICE_ID>)
ORCHESTRATOR_HOST=orchestrator-service-000000000000.us-central1.run.app
# >= 32 caracteres. Copiar el valor real desde Secret Manager (secreto device-token); no escribirlo aquí.
DEVICE_TOKEN=REEMPLAZAR_CON_EL_DEVICE_TOKEN_REAL_DE_AL_MENOS_32_CARACTERES

# --- Cámara --------------------------------------------------------------------------------------
# auto | picamera2 | usb:<idx> | file:<ruta>   (file: solo con ALLOW_TEST_VIDEO=true; nunca en producción)
CAMERA_SOURCE=auto
ALLOW_TEST_VIDEO=false
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=30

# --- Modelo e inferencia -------------------------------------------------------------------------
MODEL_PATH=/var/lib/epp-edge/models/best_ncnn_model
MODEL_IMGSZ=416
INFERENCE_FPS=5
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
MIN_SECONDS_TO_CONFIRM=1.0
MIN_FRAMES_TO_CONFIRM=3
SESSION_GAP_SECONDS=4.0

# --- Capturas y streaming ------------------------------------------------------------------------
CAPTURE_JPEG_QUALITY=90
THUMB_WIDTH=480
THUMB_JPEG_QUALITY=75
STREAM_FPS=8
STREAM_WIDTH=640
STREAM_JPEG_QUALITY=60
# true = abre el stream en cada detección (comportamiento viejo y costoso). Dejar en false.
AUTO_STREAM_ON_DETECTION=false

# --- Operación -----------------------------------------------------------------------------------
HEARTBEAT_SECONDS=300
CONTROL_SAFETY_POLL_SECONDS=300
DEFAULT_DESIRED_STATE=running
DATA_DIR=/var/lib/epp-edge
OUTBOX_MAX_BYTES=5000000000
SITE_TIMEZONE=America/Lima
# URL de healthchecks.io (opcional). Vacío = desactivado.
HEALTHCHECK_URL=
LOG_LEVEL=INFO
LOG_TO_FILE=false
