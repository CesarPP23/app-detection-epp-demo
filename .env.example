# Copia este archivo a ".env" (en la raíz del repo) y completa los valores reales.
# ".env" ya está en .gitignore - nunca lo commitees.

# Ruta al archivo de credenciales de la cuenta de servicio (JSON), relativa a la raíz del repo.
GOOGLE_APPLICATION_CREDENTIALS=raspberrypi/gcp-key.json

# Proyecto y recursos de GCP
GCP_PROJECT_ID=epp-detection-v1
PUB_SUB_TOPIC_ID=yolo-detections
FIRESTORE_DATABASE_ID=(default)
DETECTIONS_DATABASE_ID=dbraspberry
DEVICE_ID=raspberry-pi-01

# Streaming (Cloud Run orchestrator-service)
CLOUD_RUN_URL=orchestrator-service-540868081764.us-central1.run.app
UPLINK_TOKEN=cambia-este-valor-por-un-token-propio

# Detección / rendimiento (raspberrypi/main.py)
FRAME_SKIP=4
CONFIDENCE_THRESHOLD=0.5
FORCE_TEST_VIDEO=false

# Reglas de negocio anti-ruido y evento-driven (raspberrypi/main.py)
MIN_SECONDS_TO_CONFIRM=1.0
SESSION_GAP_SECONDS=4.0
STREAM_IDLE_TIMEOUT=60.0
STATE_POLL_INTERVAL=5.0

# Front-end (Flet)
BACKEND_URL=https://orchestrator-service-540868081764.us-central1.run.app/
